# =============================================================================
# StudyPilot — environment variable template
# =============================================================================
# This file IS committed to Git and contains NO real values.
# Copy it to `.env.local` and fill in your own values.
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.
# =============================================================================

# --- Supabase: Project Settings > API ----------------------------------------

# Your project URL. Looks like: https://abcdefghijklm.supabase.co
# Safe in the browser (note the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" or "publishable" key.
# Safe in the browser BY DESIGN — Supabase expects it to be public.
# Your data is protected by Row Level Security policies, not by secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" (secret) key.
# SERVER ONLY. Never expose to the browser, never commit.
# Next.js replaces non-NEXT_PUBLIC_ vars with `undefined` in the browser
# bundle, so referencing this in a Client Component fails the build.
# This bypasses Row Level Security — use it only where you have already
# verified ownership of the data in application code.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (not needed yet — planned for a later phase) ---------------------
# Add this only when we reach the AI phase. Leave blank for now.
OPENAI_API_KEY=